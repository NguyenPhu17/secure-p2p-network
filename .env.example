# ========================================================
# CẤU HÌNH MÔI TRƯỜNG - SECURE P2P NETWORK
# Sao chép file này thành .env trước khi chạy Docker Compose:
#   cp .env.example .env
# ========================================================

# 1. Cơ sở dữ liệu PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=p2p_network
DB_USER=postgres
DB_PASSWORD=change_this_strong_password

# 2. Bảo mật JWT (Chuỗi ngẫu nhiên tối thiểu 32 ký tự)
JWT_SECRET=change_this_super_secret_jwt_key_at_least_32_chars

# 3. Cổng nội bộ Manager & Registry
MANAGER_PORT=4000
REGISTRY_PORT=7000

# 4. Tài khoản quản trị Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change_this_grafana_password
