      "title": "📜 CENTRALIZED LOGS & DISTRIBUTED TRACING (Loki)",
      "type": "row"
    },
    {
      "id": 401,
      "title": "Security & Auth Audit Logs (Login, Register, Brute-force)",
      "type": "logs",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 42 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{job=\"p2p-logs\", category=~\"AUTH|SECURITY\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
    {
      "id": 402,
      "title": "System Errors & Warnings Stream",
      "type": "logs",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 42 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{job=\"p2p-logs\", level=~\"ERROR|WARN\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
