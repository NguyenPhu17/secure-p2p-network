      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 27 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "p2p_manager_nodejs_heap_size_used_bytes",
          "legendFormat": "p2p-manager",
          "refId": "A"
